<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        These resources are populated by CommonScrollBar.Apply().
        They allow the same template to be used with different
        CommonScrollBarOptions and CommonTheme instances.
    -->

    <Style
        x:Key="CommonScrollBarThumb"
        TargetType="Thumb">

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Thumb">

                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource CommonScrollBarCornerRadius}"
                        Margin="{DynamicResource CommonScrollBarTrackMargin}" />

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style
        TargetType="ScrollBar">

        <Setter
            Property="Background"
            Value="{DynamicResource CommonScrollBarBackgroundBrush}" />

        <Setter
            Property="Width"
            Value="{DynamicResource CommonScrollBarWidth}" />

        <Setter
            Property="MinWidth"
            Value="{DynamicResource CommonScrollBarWidth}" />

        <Setter
            Property="MaxWidth"
            Value="{DynamicResource CommonScrollBarWidth}" />

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="ScrollBar">

                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource CommonScrollBarCornerRadius}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <RepeatButton
                                x:Name="PART_DecreaseButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{x:Static ScrollBar.LineUpCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource CommonScrollBarThumbBrush}"
                                Padding="0"
                                Content="▲"
                                FontSize="6"
                                Visibility="{DynamicResource CommonScrollBarArrowVisibility}" />

                            <Track
                                x:Name="PART_Track"
                                Grid.Row="1"
                                Grid.Column="1"
                                IsDirectionReversed="True">

                                <Track.Thumb>
                                    <Thumb
                                        Background="{DynamicResource CommonScrollBarThumbBrush}"
                                        Style="{StaticResource CommonScrollBarThumb}" />
                                </Track.Thumb>

                            </Track>

                            <RepeatButton
                                x:Name="PART_IncreaseButton"
                                Grid.Row="2"
                                Grid.Column="1"
                                Command="{x:Static ScrollBar.LineDownCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource CommonScrollBarThumbBrush}"
                                Padding="0"
                                Content="▼"
                                FontSize="6"
                                Visibility="{DynamicResource CommonScrollBarArrowVisibility}" />

                        </Grid>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>