<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <AssemblyVersion>1.0.1.2</AssemblyVersion>

    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Livia" Version="1.20.*" />
  </ItemGroup>

  <Target Name="StripWinRTProjections" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <!-- This is admittedly pretty hacky but blame .NET for including it just because the target framework includes it -->
      <FilesToBundle Condition="'%(Filename)' == 'Microsoft.Windows.SDK.NET'" Remove="@(FilesToBundle)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="BuiltWith" Value="Livia" />
  </ItemGroup>

</Project>
